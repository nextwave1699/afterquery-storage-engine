+      std::string target;
+      AppendInternalKey(&target,
+                        ParsedInternalKey(e, kMaxSequenceNumber, kValueTypeForSeek));
+      iter_->Seek(target);
+    }
+  }
+
+  void SkipBackward() {
+    std::string b, e;
+    while (iter_->Valid() && Covered(&b, &e)) {
+      std::string target;
+      AppendInternalKey(&target,
+                        ParsedInternalKey(b, kMaxSequenceNumber, kValueTypeForSeek));
+      iter_->Seek(target);
+      if (iter_->Valid()) {
+        iter_->Prev();
+      } else {
+        iter_->SeekToLast();
+      }
+    }
+  }
