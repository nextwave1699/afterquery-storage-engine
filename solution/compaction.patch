+// For a size-triggered compaction at level >= 1, choose the input file that
+// is the cheapest to push down instead of the next one in key order:
+//
+//  * the fewer bytes of the next level the file overlaps, relative to its
+//    own size, the fewer bytes the compaction rewrites per byte moved;
+//  * a file whose contents are still being overwritten (high hotness, see
+//    FileMetaData::hotness) will be rewritten by the next merge into this
+//    level anyway, and pushing it down now only moves versions that are
+//    about to become garbage, so cold files are preferred.
+FileMetaData* VersionSet::PickCheapestFile(int level) {
+  FileMetaData* best = nullptr;
+  double best_cost = 0;
+  for (size_t i = 0; i < current_->files_[level].size(); i++) {
+    FileMetaData* f = current_->files_[level][i];
+    std::vector<FileMetaData*> overlaps;
+    current_->GetOverlappingInputs(level + 1, &f->smallest, &f->largest,
+                                   &overlaps);
+    const double rewrite_ratio =
+        1.0 + static_cast<double>(TotalFileSize(overlaps)) /
+                  static_cast<double>(std::max<uint64_t>(1, f->file_size));
+    const double cost = rewrite_ratio * (kHotnessWeight + f->hotness);
+    if (best == nullptr || cost < best_cost) {
+      best = f;
+      best_cost = cost;
+    }
+  }
+  return best;
